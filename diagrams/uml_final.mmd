
classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
        +list_tasks()
    }

    class Task {
        +str description
        +datetime due_time
        +str frequency
        +bool completed
        +str priority
        +int duration_minutes
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
        +handle_recurrence()
        +sort_by_priority()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : retrieves tasks
